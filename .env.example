APP_PORT=3000
DATABASE_URL=postgres://near_chat:near_chat@localhost:15432/near_chat
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=near-chat
MINIO_SECRET_KEY=near-chat-secret
MINIO_BUCKET=near-chat-files
FILE_MAX_BYTES=52428800
AVATAR_MAX_BYTES=8388608
FILE_USER_QUOTA_BYTES=1073741824
FILE_ORPHAN_TTL_HOURS=24
FILE_CLEANUP_INTERVAL_MINUTES=30
STORAGE_RETRY_ATTEMPTS=3
MESSAGE_RECALL_WINDOW_SECONDS=120

SEED_ADMIN_PASSWORD=admin123
SEED_DEMO_USERS=true
SEED_ALICE_PASSWORD=alice123
SEED_BOB_PASSWORD=bob123

# 可选 AI / 原生知识库：以下模型值只用于首次建库，之后在“管理中心 → AI 设置”维护。
# 管理密钥必须长期保持不变，用于加密数据库中的模型 API Key。
AI_SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-secret
AI_ENABLED=false
# OpenAI 兼容接口；也可用 AI_CHAT_* / AI_EMBEDDING_* 分别覆盖。
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
# 可选：聊天与向量服务不在同一地址时分别覆盖共享配置。
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_DIMENSIONS=1536
AI_KNOWLEDGE_CHUNK_SIZE=1200
AI_KNOWLEDGE_CHUNK_OVERLAP=180
AI_KNOWLEDGE_MAX_EXTRACTED_CHARS=2000000
AI_KNOWLEDGE_MAX_CHUNKS=1000
AI_KNOWLEDGE_POLL_MS=3000
AI_KNOWLEDGE_TOP_K=8
